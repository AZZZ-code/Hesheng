<Window x:Class="Hesheng.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Hesheng" Title="合声 · 双音箱控制台" Width="924" Height="740" MinWidth="720" MinHeight="580" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" FontFamily="Segoe UI, Microsoft YaHei UI" Background="{DynamicResource Paper}" Foreground="{DynamicResource Ink}">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Controls.xaml"/></ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="Paper" Color="#F7F6F3"/><SolidColorBrush x:Key="Ink" Color="#1B1D20"/><SolidColorBrush x:Key="Muted" Color="#5D6266"/><SolidColorBrush x:Key="Line" Color="#D6D5D1"/><SolidColorBrush x:Key="Surface" Color="#FFFFFF"/><SolidColorBrush x:Key="Pill" Color="#E9E8E4"/>
  <Style TargetType="Button">
    <Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="17,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="{DynamicResource Pill}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" CornerRadius="17" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value=".81"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value=".66"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock" x:Key="Caption"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="ComboBox"><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="8,5"/><Setter Property="MinHeight" Value="34"/><Setter Property="Foreground" Value="#202125"/></Style>
  <Style TargetType="Separator"><Setter Property="Background" Value="{DynamicResource Line}"/><Setter Property="Height" Value="1"/></Style>
</ResourceDictionary></Window.Resources>
<Border Padding="34,0" Background="{DynamicResource Paper}"><Grid><Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/><RowDefinition Height="43"/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Ink}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Rectangle Width="2" Height="8" Fill="{DynamicResource Paper}"/><Rectangle Margin="3,0" Width="2" Height="15" Fill="{DynamicResource Paper}"/><Rectangle Width="2" Height="11" Fill="{DynamicResource Paper}"/><Rectangle Margin="3,0,0,0" Width="2" Height="18" Fill="{DynamicResource Paper}"/></StackPanel></Border><TextBlock Text="合声" FontSize="21" FontWeight="DemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
 <Border Grid.Column="1" Background="{DynamicResource Pill}" CornerRadius="19" Padding="3" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Button x:Name="PlaybackTab" Content="播放" Padding="21,5" Click="PlaybackPage"/><Button x:Name="ToneTab" Content="调音" Padding="21,5" Click="TonePage"/></StackPanel></Border>
 <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal"><Button x:Name="GuideButton" Content="使用教程" Background="Transparent" Padding="8,5" FontSize="13" Click="OpenGuide"/><Button x:Name="ThemeButton" Background="Transparent" Padding="8,5" FontSize="13" Click="CycleTheme" ToolTip="切换跟随系统、浅色和深色"/></StackPanel></Grid>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="Scroller"><StackPanel>
 <Border x:Name="GuidePanel" Visibility="Collapsed" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}" Padding="22,15" Margin="0,0,0,14">
  <StackPanel>
   <DockPanel><TextBlock x:Name="GuideProgress" Style="{StaticResource Caption}" VerticalAlignment="Center"/><Button x:Name="GuideSkip" HorizontalAlignment="Right" Content="关闭教程" Click="DismissGuide" Padding="8,3" Background="Transparent" FontSize="12"/></DockPanel>
   <TextBlock x:Name="GuideHeading" FontSize="23" FontWeight="DemiBold" Margin="0,4,0,7" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock x:Name="GuideBody" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
   <TextBlock x:Name="GuideHint" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
   <DockPanel Margin="0,12,0,0"><Button x:Name="GuideListen" DockPanel.Dock="Left" Content="播放测试音" Padding="12,5" Click="TestSound" Visibility="Collapsed"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button x:Name="GuideBack" Content="上一步" Background="Transparent" Padding="12,5" Click="BackGuide"/><Button x:Name="GuideNext" Content="下一步" Padding="14,5" Click="NextGuide"/></StackPanel></DockPanel>
  </StackPanel>
 </Border>
 <Grid x:Name="Pages">
<StackPanel x:Name="Playback">
 <Border x:Name="PlaybackHero" Background="#161719" CornerRadius="19" ClipToBounds="True"><Grid Height="279" ClipToBounds="True">
   <local:DriverArt HorizontalAlignment="Right" Width="340" Margin="0,4,6,4" IsHitTestVisible="False"/>
   <Border HorizontalAlignment="Left" Width="445" CornerRadius="19,0,0,19"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF161719" Offset="0"/><GradientStop Color="#FF161719" Offset=".65"/><GradientStop Color="#00161719" Offset="1"/></LinearGradientBrush></Border.Background></Border>
   <StackPanel Margin="32,27" HorizontalAlignment="Left" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal"><Ellipse x:Name="Indicator" Width="7" Height="7" Margin="0,1,8,0" Fill="#BCC0C3"/><TextBlock x:Name="StateText" Foreground="#DBDEDD" FontSize="13"/></StackPanel>
    <TextBlock Text="双音箱播放" FontSize="42" FontWeight="DemiBold" Foreground="#FAFAF8" Margin="0,7,0,4"/>
    <TextBlock x:Name="RouteText" Foreground="#C4C6C7" FontSize="15" MaxWidth="390" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"/>
    <StackPanel Orientation="Horizontal" Margin="0,24,0,0"><Button x:Name="Transport" Background="#F4F4F0" Foreground="#1D1F20" Click="ToggleRoute"/><Button x:Name="TestButton" Margin="9,0,0,0" Background="#343638" Foreground="White" Content="播放测试音" Click="TestSound"/></StackPanel>
   </StackPanel>
 </Grid></Border>
 <Grid Margin="0,24,0,10"><TextBlock Text="输出设备" FontSize="22" FontWeight="DemiBold"/><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal"><Button x:Name="Refresh" Click="RefreshDevices" Background="Transparent" Content="刷新设备" Padding="8,4" FontSize="13"/><Button x:Name="ApplyDevices" Content="应用切换" Click="ApplySelection" Margin="8,0,0,0" Padding="13,5" Visibility="Collapsed"/></StackPanel></Grid>
 <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="13" Background="{DynamicResource Surface}" Padding="18,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="45"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <StackPanel><TextBlock Text="主音箱 · 系统声音来源" Style="{StaticResource Caption}" Margin="1,0,0,7"/><ComboBox Style="{StaticResource Selector}" x:Name="Source" AutomationProperties.Name="主音箱" SelectionChanged="DeviceChanged"/></StackPanel>
 <TextBlock Grid.Column="1" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="21" Foreground="{DynamicResource Muted}"/>
 <StackPanel Grid.Column="2"><TextBlock Text="副音箱 · 镜像输出" Style="{StaticResource Caption}" Margin="1,0,0,7"/><ComboBox Style="{StaticResource Selector}" x:Name="Target" AutomationProperties.Name="副音箱" SelectionChanged="DeviceChanged"/></StackPanel></Grid></Border>
 <Grid Margin="0,24,0,6"><TextBlock Text="时间对齐" FontSize="20" FontWeight="DemiBold"/><TextBlock x:Name="DelayText" HorizontalAlignment="Right" FontSize="18" FontFamily="Consolas"/></Grid>
 <TextBlock Text="副音箱先响时，增加它的播放延迟。" Style="{StaticResource Caption}"/>
 <Slider x:Name="Delay" Minimum="0" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,12,0,8" AutomationProperties.Name="副音箱延迟" ValueChanged="DelayChanged"/>
</StackPanel>
<StackPanel x:Name="TonePagePanel" Visibility="Collapsed">
 <Border CornerRadius="17" Background="#17191B" Padding="26,18,24,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="98"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="EqTarget" Foreground="#B9BCB9" FontSize="12"/><TextBlock Text="副音箱均衡器" Foreground="#F5F5F1" FontSize="28" FontWeight="DemiBold" Margin="0,3,0,0"/></StackPanel><Button x:Name="Bypass" Click="ToggleEq" VerticalAlignment="Top" HorizontalAlignment="Right" Background="#383B3E" Foreground="White" Padding="12,5"/><local:ResponsePlot x:Name="Plot" Grid.Row="1"/></Grid></Border>
 <WrapPanel x:Name="PresetBar" Margin="0,16,0,5"/>
 <Border CornerRadius="14" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="16,10"><StackPanel><UniformGrid Rows="1" Columns="5" x:Name="Faders"/>
 <Separator Margin="0,8,0,8"/><DockPanel><TextBlock DockPanel.Dock="Left" Text="前级增益" VerticalAlignment="Center"/><TextBlock x:Name="PreText" DockPanel.Dock="Right" Width="72" TextAlignment="Right" VerticalAlignment="Center"/><Slider x:Name="Pre" Minimum="-18" Maximum="0" TickFrequency=".5" IsSnapToTickEnabled="True" AutomationProperties.Name="前级增益" Margin="20,0" ValueChanged="BandChanged"/></DockPanel></StackPanel></Border>
 <WrapPanel Margin="0,12,0,6"><TextBlock Text="预设名称" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Caption}"/><TextBox x:Name="PresetName" Width="128" MaxLength="24" Padding="6,5" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="输入预设名称" AutomationProperties.Name="自定义预设名称"/><Button Content="保存预设" Click="SavePreset" Padding="13,6"/><Button Content="复位为原声" Background="Transparent" Click="ResetEq" Padding="13,6"/></WrapPanel>
</StackPanel>
</Grid></StackPanel></ScrollViewer>
<Grid Grid.Row="2"><Border VerticalAlignment="Top" Height="1" Background="{DynamicResource Line}"/><Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Message" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="输出电平" FontSize="11" Foreground="{DynamicResource Muted}" Margin="12,0,8,0"/><Border Background="{DynamicResource Pill}" Width="60" Height="5" VerticalAlignment="Center" CornerRadius="2"><Border x:Name="Level" HorizontalAlignment="Left" Width="0" Background="#819A73" CornerRadius="2"/></Border></StackPanel></Grid></Grid>
</Grid></Border></Window>
